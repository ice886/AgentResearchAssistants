# 复制为 .env 并按需填写。所有变量以 AR_ 前缀，嵌套用 __ 分隔。
# API key 走环境变量，不入库、不写日志。
AR_ANTHROPIC_API_KEY=

# 中转站配置（使用第三方代理时填写，留空则直连 Anthropic 官方 API）
# AR_ANTHROPIC_BASE_URL=https://your-proxy.example.com/v1

# 中转站模型名（如与官方不同，可按角色覆盖）
# AR_MODELS__DEFAULT_MODEL=claude-opus-4-8

AR_RUNS_DIR=runs
# 示例：覆盖资源限额
# AR_LIMITS__CONTAINER_CPUS=4
# AR_LIMITS__CONTAINER_MEM_MB=8192
# AR_LIMITS__CONTAINER_TIMEOUT_S=600
# AR_LIMITS__MAX_CONCURRENT_CONTAINERS=2
# AR_DOCKER__BASE_IMAGE_TAG=agent-research/base:latest
# AR_DOCKER__NETWORK_POLICY=none
# AR_DOCKER__RUN_AS_NON_ROOT=true
# AR_DOCKER__NON_ROOT_USER=1000:1000
# AR_DOCKER__WORKDIR=/workspace
# AR_DOCKER__IDLE_COMMAND=sleep infinity
