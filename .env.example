# 复制为 .env 并按需填写。所有变量以 AR_ 前缀，嵌套用 __ 分隔。
# API key 走环境变量，不入库、不写日志。
AR_ANTHROPIC_API_KEY=
AR_RUNS_DIR=runs
# 示例：覆盖资源限额
# AR_LIMITS__CONTAINER_CPUS=4
# AR_LIMITS__CONTAINER_MEM_MB=8192
# AR_LIMITS__CONTAINER_TIMEOUT_S=600
# AR_DOCKER__BASE_IMAGE_TAG=agent-research/base:latest
# AR_DOCKER__NETWORK_POLICY=none
